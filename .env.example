# Copy to `.env` to override Compose defaults, or to run the backend natively.
# Compose auto-loads `.env`; it is git-ignored.

# --- Postgres (Compose `db` service) ---
POSTGRES_USER=wmp
POSTGRES_PASSWORD=wmp
POSTGRES_DB=wmp

# --- API ---
# Native dev: point at your local Postgres, e.g.
#   postgres://wmp:wmp@localhost:5432/wmp
DATABASE_URL=postgres://wmp:wmp@db:5432/wmp
PORT=3000
LOG_LEVEL=info

# Auth (ADR-0005). `true` (default) → OIDC via Keycloak with a backend-for-
# frontend session cookie: the backend is a confidential client, exchanges the
# code and holds the tokens server-side, the browser gets only the opaque
# session id. `false` → skip Keycloak; one implicit local user owns everything
# (handy for quick native runs without the OIDC setup).
AUTH_ENABLED=true
# Public realm URL: where the browser is redirected for login/logout, and the
# `iss` the backend requires on tokens. Must match Keycloak's KC_HOSTNAME.
OIDC_ISSUER_URL=http://localhost:8081/realms/wmp
# Where the backend reaches Keycloak for the code exchange and JWKS. In Compose
# this is the in-cluster address; for a natively-run backend set it to
# http://localhost:8081/realms/wmp.
OIDC_INTERNAL_URL=http://keycloak:8080/realms/wmp
OIDC_AUDIENCE=wmp-api
OIDC_CLIENT_ID=wmp-api
OIDC_CLIENT_SECRET=dev-secret-change-me
# Absolute URL Keycloak redirects the browser back to (must be in the client's
# redirectUris). Native dev: http://localhost:3000/api/auth/callback.
OIDC_REDIRECT_URI=https://localhost:8443/api/auth/callback
# SPA route to land on after login completes.
OIDC_POST_LOGIN_REDIRECT=/
SESSION_COOKIE_NAME=wmp.sid
SESSION_TTL_HOURS=168
# Must be false over plain HTTP (native dev); true behind the Compose TLS proxy.
SESSION_COOKIE_SECURE=false

# Uploads (SNG-1). Keep MAX_UPLOAD_BYTES in sync with nginx client_max_body_size.
MAX_UPLOAD_BYTES=20971520

# --- Storage (ADR-0004) ---
# local (default) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Only needed with STORAGE_DRIVER=s3 (Compose profile `storage-s3` runs MinIO).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=wmp-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Compose published ports ---
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Keycloak (Compose `keycloak` service; own DB `keycloak-db`) ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8081
# Browser-facing base URL of Keycloak (KC_HOSTNAME). Keep the port in sync with
# KEYCLOAK_PORT; the `/realms/wmp` suffix in OIDC_ISSUER_URL must point here.
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
KEYCLOAK_DB_NAME=keycloak
