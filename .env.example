# Copy to `.env` to override Compose defaults, or to run the backend natively.
# Compose auto-loads `.env`; it is git-ignored.

# --- Postgres (Compose `db` service) ---
POSTGRES_USER=wmp
POSTGRES_PASSWORD=wmp
POSTGRES_DB=wmp

# --- API ---
# Native dev: point at your local Postgres, e.g.
#   postgres://wmp:wmp@localhost:5432/wmp
DATABASE_URL=postgres://wmp:wmp@db:5432/wmp
PORT=3000
LOG_LEVEL=info

# Auth (ADR-0005). `false` → one implicit local user owns everything.
# `true` currently returns 501 until the identity slice is built.
AUTH_ENABLED=false
SESSION_COOKIE_NAME=wmp.sid
SESSION_TTL_HOURS=168
# Must be false over plain HTTP (native dev); true behind the Compose TLS proxy.
SESSION_COOKIE_SECURE=false
BCRYPT_COST=12

# Uploads (SNG-1). Keep MAX_UPLOAD_BYTES in sync with nginx client_max_body_size.
MAX_UPLOAD_BYTES=20971520

# --- Storage (ADR-0004) ---
# local (default) | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Only needed with STORAGE_DRIVER=s3 (Compose profile `storage-s3` runs MinIO).
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=wmp-audio
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# --- Compose published ports ---
HTTP_PORT=8080
HTTPS_PORT=8443
