  "info": {
    "title": "Web Music Player API",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "schemas": {
      "CredentialsDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "createdAt"
        ]
      },
      "SessionDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ]
      },
      "SongDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "artist": {
            "type": "string"
          },
          "album": {
            "type": "string"
          },
          "duration": {
            "type": "number"
          },
          "hasCover": {
            "type": "boolean"
          },
          "addedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "ownerId",
          "title",
          "duration",
          "hasCover",
          "addedAt"
        ]
      },
      "UpdateSongDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "artist": {
            "type": "string"
          },
          "album": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      },
      "PlaylistEntryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "songId": {
            "type": "string"
          },
          "position": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "songId",
          "position"
        ]
      },
      "PlaylistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "ownerId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaylistEntryDto"
            }
          },
          "trackCount": {
            "type": "number"
          }
        },
        "required": [
          "id",
          "ownerId",
          "name",
          "entries",
          "trackCount"
        ]
      },
      "CreatePlaylistDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "RenamePlaylistDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name"
        ]
      },
      "AddEntryDto": {
        "type": "object",
        "properties": {
          "songId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "songId"
        ]
      },
      "ReorderEntriesDto": {
        "type": "object",
        "properties": {
          "entryIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        },
        "required": [
          "entryIds"
        ]
      }
    }
  }
}
